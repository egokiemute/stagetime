{
  "name": "stagetimer",
  "version": "1.0.4",
  "description": "Stage countdown timer for church services — control window + projector display window.",
  "main": "main.js",
  "author": {
    "name": "Ego Okiemute",
    "email": "ego.okiemute@gmail.com"
  },
  "repository": "github:egokiemute/stagetime",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --dir",
    "dmg": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "plus.tbh.stagetimer",
    "productName": "Stage Timer",
    "files": [
      "main.js",
      "preload.js",
      "shared.js",
      "program.js",
      "control.html",
      "control.css",
      "control.js",
      "display.html",
      "display.css",
      "display.js"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "identity": null,
      "artifactName": "Stage-Timer-${arch}.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "Stage-Timer-Setup.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "Stage-Timer.${ext}"
    }
  }
}
